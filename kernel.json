{
  "target": "aarch64-qemu-virt",

  "components": {
    "char_device.serial": {
      "impl": "uart_pl011",
      "config": {
        "base_addr": "0x09000000"
      }
    },
    "scheduler": {
      "impl": "sched_priority",
      "alternatives": ["sched_rr"],
      "config": {}
    },
    "memory.page_alloc": {
      "impl": "mm_buddy",
      "config": {}
    },
    "filesystem.root": {
      "impl": "ramfs",
      "config": {}
    },
    "filesystem.proc": {
      "impl": "procfs",
      "config": {}
    },
    "vfs": {
      "impl": "vfs_simple",
      "config": {}
    },
    "posix_shim": {
      "impl": "posix_shim",
      "config": {}
    }
  },

  "connections": [],

  "hooks": [],

  "posix": {
    "enabled": false
  }
}
